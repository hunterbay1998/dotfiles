{
  /* Custom 1–5 for Hyprland 0.56+ Lua dispatch.
     Updates via signal 1 (ws-events.sh + on-click), not 1s polling. */

  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/ws.sh 1",
    "interval": 30,
    "signal": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 1 })\" && pkill -RTMIN+1 waybar"
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/ws.sh 2",
    "interval": 30,
    "signal": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 2 })\" && pkill -RTMIN+1 waybar"
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/ws.sh 3",
    "interval": 30,
    "signal": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 3 })\" && pkill -RTMIN+1 waybar"
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/ws.sh 4",
    "interval": 30,
    "signal": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 4 })\" && pkill -RTMIN+1 waybar"
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/ws.sh 5",
    "interval": 30,
    "signal": 1,
    "return-type": "json",
    "format": "{}",
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 5 })\" && pkill -RTMIN+1 waybar"
  }
}
