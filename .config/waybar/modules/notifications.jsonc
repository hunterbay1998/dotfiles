{
  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "makoctl dismiss -a",
    "on-click-right": "makoctl mode -t do-not-disturb",
    "on-click-middle": "makoctl restore",
    "escape": true
  }
}
