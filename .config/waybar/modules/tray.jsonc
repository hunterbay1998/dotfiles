{
  /* Click the icon to expand tray icons; click again / leave to collapse.
     First module is the always-visible handle — no on-click (conflicts with drawer). */
  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250,
      "children-class": "tray-item",
      "click-to-reveal": true,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray-icon",
      "tray"
    ]
  },

  "custom/tray-icon": {
    "format": "󰍜",
    "tooltip": "System tray (click to expand)"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  }
}
